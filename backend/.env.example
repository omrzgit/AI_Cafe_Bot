# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# App Settings
COMPANY_NAME=Fireball Cafe & Booking
APP_NAME=AICafeAppointmentBot
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
SESSION_EXPIRY_HOURS=24

# Database
DATABASE_URL=sqlite+aiosqlite:///./appointments.db
SYNC_DATABASE_URL=sqlite:///./appointments.db
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=AI-CAFEBOT

# Google Calendar (Optional for Auto Calendar Booking & Meet Links)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_ID=primary
